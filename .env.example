# Copy to .env and fill in. `make db-up` starts a matching local Postgres on 5433.
DATABASE_URL=postgres://acme:acme@localhost:5433/acme
# REQUIRED — the app refuses to start without it. Generate one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin used to build shortUrl values
BASE_URL=http://localhost:3000
